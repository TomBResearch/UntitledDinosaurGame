{
  "name": "@udg/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "UDG @udg/protocol workspace. domain declarations, wire envelopes, validation and replica schemas. Implemented by UDG-002: types, bounds and mapping only, with no movement, admission or SDK behaviour.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.22.2",
    "pnpm": "12.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./mapping": {
      "types": "./dist/mapping/index.d.ts",
      "default": "./dist/mapping/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.45"
  }
}
