{
  "name": "@udg/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "UDG @udg/config workspace. readonly movement, network, limit and region configuration plus canonical hashes. Implemented by UDG-002: validated values and hashes only, with no production region bounds default.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.22.2",
    "pnpm": "12.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@udg/protocol": "workspace:*"
  }
}
