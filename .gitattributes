# Normalise line endings for text
* text=auto eol=lf

# Large binary assets go through Git LFS
*.blend filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.png filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.wav filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.ogg filter=lfs diff=lfs merge=lfs -text
assets-src/**/*.psd filter=lfs diff=lfs merge=lfs -text
client/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
client/assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
client/assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
client/assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
client/assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text

# Generated code: collapse in diffs
server/internal/proto/*_gen.go linguist-generated=true
client/net/proto/*.gd linguist-generated=true
