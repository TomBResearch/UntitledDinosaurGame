# Example environment for local development. This file must never contain a secret, token or
# reconnection credential. Copy it to .env.local only if a tool needs overrides; .env* is ignored.
#
# UDG-001 defines the values and their bounds. Servers must refuse to start on a non-loopback
# bind unless UDG-003's explicit opt-in flag is set, so the defaults below are loopback-only.

# Development server bind address. Loopback only for local work.
UDG_HOST=127.0.0.1

# Colyseus development server port (repository contract: 2567).
UDG_SERVER_PORT=2567

# Vite development client port (repository contract: 5173).
UDG_CLIENT_PORT=5173

# Vite development server BIND address, and the only variable that changes what `pnpm dev` binds to.
# Unset or 127.0.0.1 keeps the server on this machine's own loopback, which is the default and the safe
# setting: reachable locally, unreachable through a published container port, unreachable from anything
# else on the network.
#
# Any other value EXPOSES THE PORT. Set UDG_DEV_HOST=0.0.0.0 only inside a container whose port mapping is
# itself bound to the host's loopback (`docker run -p 127.0.0.1:5173:5173 ...`), which is the documented
# preview route in docs/contracts/assignments/UDG-004.md §7 — and only when you want to look at the scene
# from that host's browser. It is never set by this repository, the browser suite never needs it, and the
# dev server prints a warning when it is set to anything but loopback.
# UDG_DEV_HOST=127.0.0.1

# Client-side development server URL used by the browser app when it starts.
UDG_SERVER_URL=ws://127.0.0.1:2567

# Structured log level: debug | info | warn | error
UDG_LOG_LEVEL=info
