# Example environment for local development. This file must never contain a secret, token or
# reconnection credential. Copy it to .env.local only if a tool needs overrides; .env* is ignored.
#
# UDG-001 defines the values and their bounds. Servers must refuse to start on a non-loopback
# bind unless UDG-003's explicit opt-in flag is set, so the defaults below are loopback-only.

# Development server bind address. Loopback only for local work.
UDG_HOST=127.0.0.1

# Colyseus development server port (repository contract: 2567).
UDG_SERVER_PORT=2567

# Vite development client port (repository contract: 5173).
UDG_CLIENT_PORT=5173

# Client-side development server URL used by the browser app when it starts.
UDG_SERVER_URL=ws://127.0.0.1:2567

# Structured log level: debug | info | warn | error
UDG_LOG_LEVEL=info
