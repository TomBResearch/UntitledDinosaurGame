# Environment for running the backend API locally (CLAUDE.md, "Commands"). Copy to infra/dev/api.env
# (ignored by git) and fill in DINOSAUR_SERVICE_KEY.
#
#   cd server && set -a && . ../infra/dev/api.env && set +a && go run ./cmd/api
#
# The local database from infra/dev/docker-compose.yml.
DATABASE_URL=postgres://udg:udg@127.0.0.1:5433/udg?sslmode=disable
# Any 32+ characters; give the local world server the same value. For example: openssl rand -base64 36
WORLD_TICKET_KEY=
# The platform's service key for "dinosaur". Ask the owner, or use your local platform's.
DINOSAUR_SERVICE_KEY=
