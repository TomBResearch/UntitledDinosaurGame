# Exact versions only: pnpm add must never insert ^ or ~ (repository.md 3.1).
save-exact=true
# The pinned runtime is part of the reproducibility claim, so a mismatched runtime stops.
engine-strict=true
# Lockfile integrity is required; never install a mutated store entry silently.
verify-store-integrity=true
# The lockfile must not depend on the developer's global profile.
global-pnpmfile=false
