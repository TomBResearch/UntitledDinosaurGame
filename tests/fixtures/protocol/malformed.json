      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ]
      }
    },
    {
      "caseId": "P35",
      "note": "an unnormalised yaw is refused by mapping rather than quietly wrapped",
      "target": "toReplica",
      "encoding": "json",
      "input": {
        "player": "@player-yaw-pi"
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ],
        "asserts": {
          "stateUnchanged": true
        }
      }
    },
    {
      "caseId": "P36",
      "note": "a signed zero in canonical state is refused, because the wire would turn it into +0",
      "target": "toReplica",
      "encoding": "json",
      "input": {
        "player": "@player-negative-zero"
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
