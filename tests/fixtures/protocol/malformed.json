          "neutralisesToZero": true
        }
      }
    },
    {
      "caseId": "P22",
      "note": "tagged negative infinity in the second axis",
      "target": "validateDirectFrame",
      "encoding": "json-tagged",
      "input": {
        "sessionEpoch": 7,
        "generation": 11,
        "directIntent": true,
        "moveX": 0,
        "moveZ": {
          "number": "-Infinity"
        }
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ],
        "asserts": {
          "neutralisesToZero": true
        }
      }
    },
    {
      "caseId": "P23",
      "note": "tagged NaN in a destination coordinate",
      "target": "validateMoveTo",
      "encoding": "json-tagged",
      "input": {
        "requestId": "move-nan",
        "sessionEpoch": 7,
        "generation": 11,
        "x": {
          "number": "NaN"
        },
        "y": 0.9,
        "z": 0
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ]
      }
    },
    {
      "caseId": "P24",
      "note": "an axis outside the inclusive range is refused, never clamped to the limit",
      "target": "validateDirectFrame",
      "encoding": "json",
      "input": {
        "sessionEpoch": 7,
        "generation": 11,
        "directIntent": true,
        "moveX": 1.0000001,
        "moveZ": 0
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ],
        "asserts": {
          "notClamped": true
        }
      }
    },
    {
      "caseId": "P25",
      "note": "a negative or fractional generation is invalid, including one that is merely a whole-number float above the declared maximum",
      "target": "validateDirectFrame",
      "encoding": "json",
      "input": {
        "sessionEpoch": 7,
        "generation": 10.5,
        "directIntent": true,
        "moveX": 0.5,
        "moveZ": 0
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_GENERATION"
        ]
      }
    },
    {
      "caseId": "P26",
      "note": "generation zero with a real intention is invalid; only the neutral initial frame may use zero",
      "target": "validateDirectFrame",
      "encoding": "json",
      "input": {
        "sessionEpoch": 7,
        "generation": 0,
        "directIntent": true,
        "moveX": 0.5,
        "moveZ": 0
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_GENERATION"
        ]
      }
    },
    {
      "caseId": "P27",
      "note": "a keepalive frame that smuggles an intention is invalid and must neutralise, not move",
      "target": "validateDirectFrame",
      "encoding": "json",
      "input": {
        "sessionEpoch": 7,
        "generation": 12,
        "directIntent": false,
        "moveX": 1,
        "moveZ": 0
