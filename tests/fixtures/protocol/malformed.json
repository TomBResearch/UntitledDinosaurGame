{
  "fixtureVersion": "udg-protocol-fixtures-1",
  "fixtureId": "UDG-002-protocol-malformed",
  "kind": "protocol-wire-negative",
  "ownerTask": "UDG-002",
  "protocolVersion": "udg-m0-1.0.0",
  "configHash": "948f8c10fc404e2ebdb015abc8e30b8e66caf357347db3a2636ace96687a208a",
  "seed": null,
  "boundsProvenance": "test-only-synthetic",
  "bounds": {
    "x": {
      "min": -100,
      "max": 100
    },
    "y": {
      "min": -10,
      "max": 50
    },
    "z": {
      "min": -100,
      "max": 100
    }
  },
  "spawn": {
    "x": 0,
    "y": 0.9,
    "z": 0
  },
  "context": {
    "sessionEpoch": 7,
    "generationWatermark": 10,
    "currentRouteRevision": 3,
    "entityId": "entity-001",
    "manifestHash": "1111111111111111111111111111111111111111111111111111111111111111"
  },
  "note": "P01 to P12 are the required malformed set from docs/validation/fixtures.md 7.2; P21 to P24 are added cases, which 7.2 permits while forbidding removal. NaN and infinities are injected as real binary doubles because JSON cannot represent them, and a set that only used JSON would prove nothing about the wire path (7.1). Every case names the refusal it expects: passing because something threw is not a pass.",
  "cases": [
    {
      "caseId": "P01",
      "note": "NaN in a replicated float64 field, injected as the real IEEE-754 double",
      "target": "fromReplica",
      "encoding": "binary",
      "binary": {
        "codec": "schema-v5",
        "schema": "PlayerSchema",
        "base": "@player-motion",
        "patch": {
          "field": "x",
          "value": {
            "number": "NaN"
          }
        }
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ],
        "asserts": {
          "stateUnchanged": true
        }
      }
    },
    {
      "caseId": "P02",
      "note": "positive and negative infinity in the velocity fields",
      "target": "fromReplica",
      "encoding": "binary",
      "binary": {
        "codec": "schema-v5",
        "schema": "PlayerSchema",
        "base": "@player-motion",
        "patch": {
          "field": "vy",
          "value": {
            "number": "Infinity"
          }
        }
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ],
        "asserts": {
          "stateUnchanged": true
        }
      }
    },
    {
      "caseId": "P03",
      "note": "a numeric string where a number is declared",
      "target": "validateDirectFrame",
      "encoding": "json",
      "input": {
        "sessionEpoch": 7,
        "generation": 11,
        "directIntent": true,
        "moveX": "0.5",
        "moveZ": 0
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ],
        "asserts": {
          "neutralisesToZero": true
        }
      }
    },
    {
      "caseId": "P04",
      "note": "null in a number field",
      "target": "validateDirectFrame",
      "encoding": "json",
      "input": {
        "sessionEpoch": 7,
        "generation": 11,
        "directIntent": true,
        "moveX": null,
        "moveZ": 0
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ],
        "asserts": {
          "neutralisesToZero": true
        }
      }
    },
    {
      "caseId": "P05",
      "note": "an array where a scalar is declared",
      "target": "validateDirectFrame",
      "encoding": "json",
      "input": {
        "sessionEpoch": 7,
        "generation": 11,
        "directIntent": true,
        "moveX": [
          0
        ],
        "moveZ": 0
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ],
        "asserts": {
          "neutralisesToZero": true
        }
      }
    },
    {
      "caseId": "P06",
      "note": "a missing declared field never becomes a default",
      "target": "validateDirectFrame",
      "encoding": "json",
      "input": {
        "sessionEpoch": 7,
        "generation": 11,
        "moveX": 0.5,
        "moveZ": 0
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ]
      }
    },
    {
      "caseId": "P07",
      "note": "an unknown application field is rejected rather than ignored",
      "target": "validateDirectFrame",
      "encoding": "json",
      "input": {
        "sessionEpoch": 7,
        "generation": 11,
        "directIntent": true,
        "moveX": 0.5,
        "moveZ": 0,
        "boost": 2
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ]
      }
    },
    {
      "caseId": "P08",
      "note": "an oversized identifier, and a unicode identifier which is a rejection rather than a normalisation",
      "target": "validateMoveTo",
      "encoding": "json",
      "input": {
        "requestId": "012345678901234567890123456789012345678901234567890123456789012345678",
        "sessionEpoch": 7,
        "generation": 11,
        "x": 0,
        "y": 0.9,
        "z": 0
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ]
      }
    },
    {
      "caseId": "P09",
      "note": "an integer beyond the safe double range cannot be a generation",
      "target": "validateDirectFrame",
      "encoding": "json",
      "input": {
        "sessionEpoch": 7,
        "generation": 9007199254740992,
        "directIntent": true,
        "moveX": 0.5,
        "moveZ": 0
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_GENERATION"
        ]
      }
    },
    {
      "caseId": "P10",
      "note": "an enum value outside the closed set, in both a status payload and a canonical state",
      "target": "validateRouteStatus",
      "encoding": "json",
      "input": {
        "entityId": "entity-001",
        "sessionEpoch": 7,
        "generation": 20,
        "routeRevision": 3,
        "status": "FLYING",
        "serverTick": 4321
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ]
      }
    },
    {
      "caseId": "P11",
      "note": "a truncated frame: the framing failure stays contained to the offender and yields no state",
      "target": "fromReplica",
      "encoding": "binary",
      "binary": {
        "codec": "schema-v5",
        "schema": "PlayerSchema",
        "base": "@player-motion",
        "truncateTo": 3
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ],
        "asserts": {
          "contained": true,
          "stateUnchanged": true
        }
      }
    },
    {
      "caseId": "P12",
      "note": "client-authoritative fields are refused on sight: position, speed, elapsed time, route, authority tick and a private sequence",
      "target": "validateDirectFrame",
      "encoding": "json",
      "input": {
        "sessionEpoch": 7,
        "generation": 11,
        "directIntent": true,
        "moveX": 0.5,
        "moveZ": 0,
        "position": {
          "x": 99,
          "y": 0.9,
          "z": 99
        }
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ]
      }
    },
    {
      "caseId": "P21",
      "note": "tagged NaN in an axis, expanded by the loader (docs/validation/fixtures.md 7.1)",
      "target": "validateDirectFrame",
      "encoding": "json-tagged",
      "input": {
        "sessionEpoch": 7,
        "generation": 11,
        "directIntent": true,
        "moveX": {
          "number": "NaN"
        },
        "moveZ": 0
      },
      "expect": {
        "ok": false,
        "errorCodes": [
