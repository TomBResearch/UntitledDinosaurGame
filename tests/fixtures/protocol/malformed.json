      "expect": {
        "ok": false,
        "errorCodes": [
          "OUT_OF_BOUNDS"
        ],
        "asserts": {
          "notClamped": true
        }
      }
    },
    {
      "caseId": "P30",
      "note": "a hash field that is not 64 lowercase hexadecimal characters",
      "target": "validateJoin",
      "encoding": "json",
      "input": {
        "protocolVersion": "MATCH_PROTOCOL_VERSION",
        "configHash": "ABC",
        "manifestHash": "1111111111111111111111111111111111111111111111111111111111111111"
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ]
      }
    },
    {
      "caseId": "P31",
      "note": "a non-finite integrator scalar must not be projected into a replica",
      "target": "toReplica",
      "encoding": "json-tagged",
      "input": {
        "player": "@player-motion",
        "patch": {
          "path": "locomotion.kinematic.verticalVelocity",
          "value": {
            "number": "NaN"
          }
        }
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ]
      }
    },
    {
      "caseId": "P32",
      "note": "an out-of-range integer attempted against a uint8 enum field is refused by mapping before the codec can wrap it",
      "target": "toReplica",
      "encoding": "json",
      "input": {
        "player": "@player-motion",
        "patch": {
          "path": "locomotion.mode",
          "value": "sidling"
        }
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ]
      }
    },
    {
      "caseId": "P33",
      "note": "the same rule for a client-supplied speed and elapsed time",
      "target": "validateDirectFrame",
      "encoding": "json",
      "input": {
        "sessionEpoch": 7,
        "generation": 11,
        "directIntent": true,
        "moveX": 0.5,
        "moveZ": 0,
        "speed": 12,
        "elapsedMs": 33
      },
      "expect": {
        "ok": false,
        "errorCodes": [
          "INVALID_PAYLOAD"
        ]
      }
    },
    {
