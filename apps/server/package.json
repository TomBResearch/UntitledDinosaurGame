{
  "name": "@udg/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "UDG @udg/server workspace. Colyseus region room, fixed-step authority, input admission and replication. Implemented by UDG-003; intentionally empty in the UDG-001 foundation.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.22.2",
    "pnpm": "12.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import{rmSync}from'node:fs';for(const p of ['dist','probes/dist'])rmSync(p,{recursive:true,force:true});\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:probes": "tsc -p tsconfig.probes.json --noEmit",
    "build:probes": "tsc -p tsconfig.probes.json --noCheck",
    "build": "pnpm run clean && tsc -p tsconfig.json && tsc -p tsconfig.probes.json --noCheck"
  },
  "dependencies": {
    "@colyseus/core": "0.18.27",
    "@colyseus/sdk": "0.18.9",
    "@colyseus/ws-transport": "0.18.4",
    "@udg/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/express": "5.0.4",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
