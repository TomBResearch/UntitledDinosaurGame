{
  "name": "@udg/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "UDG @udg/client workspace. Babylon presentation, camera, input adapters and the SDK prediction wrapper. Implemented by UDG-004; intentionally empty in the UDG-001 foundation.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.22.2",
    "pnpm": "12.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@babylonjs/core": "8.56.2",
    "@udg/config": "workspace:*",
    "@udg/protocol": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
